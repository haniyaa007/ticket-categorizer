# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# --- Embeddings: "sentence-transformers" (recommended) or "tfidf" (tiny/offline) ---
TC_EMBEDDING_BACKEND=sentence-transformers
TC_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Security for the HTTP API: clients must send header  X-API-Key: <this value> ---
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
TC_API_KEY=

# --- Optional: AI-written cluster titles/summaries (only redacted subjects are sent) ---
TC_LLM_LABELING=false
ANTHROPIC_API_KEY=
TC_LLM_MODEL=claude-haiku-5-5

# --- Optional: your own taxonomy / routing rules (see `ticketsorter init-config`) ---
# TC_CATEGORIES_PATH=config/categories.yaml
# TC_ROUTING_PATH=config/routing.yaml

# --- Tuning ---
# TC_MIN_CLUSTER_SIZE=3
# TC_CATEGORY_THRESHOLD=0.30
# TC_MAX_BATCH_SIZE=1000
# TC_LOG_LEVEL=INFO

# --- Optional: Zendesk connector ---
# ZENDESK_SUBDOMAIN=yourcompany
# ZENDESK_EMAIL=agent@yourcompany.com
# ZENDESK_API_TOKEN=
